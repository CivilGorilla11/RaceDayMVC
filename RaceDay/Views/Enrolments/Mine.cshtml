@model List<EnrolmentViewModel>
@{
    ViewData["Title"] = "My enrolments";
}

<h1 class="mb-3">My enrolments</h1>

@if (!Model.Any())
{
    <p>You have not enrolled for any events yet.</p>
    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary">Browse events</a>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Enrolment</th>
                    <th>Category</th>
                    <th>Date enrolled</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td>#@e.EnrolmentId</td>
                        @* Shows the category id until your API returns names (see EnrolmentViewModel). *@
                        <td>@e.CategoryId</td>
                        <td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td>
                        <td><partial name="_StatusBadge" model="e.Status" /></td>
                        <td class="text-end">
                            <form asp-action="Delete" asp-route-id="@e.EnrolmentId" method="post" class="d-inline"
                                  onsubmit="return confirm('Withdraw from this event?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Withdraw</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}