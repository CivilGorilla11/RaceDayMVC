@model ResultFormViewModel

@* Three hidden ids: the form model needs them on the way back, but the user never edits them. *@
<input type="hidden" asp-for="ResultId" />
<input type="hidden" asp-for="EnrolmentId" />
<input type="hidden" asp-for="EventId" />

<div class="mb-3">
    <label asp-for="FinishTime" class="form-label"></label>
    <input asp-for="FinishTime" class="form-control" placeholder="01:45:30" />
    <span asp-validation-for="FinishTime" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Position" class="form-label"></label>
    <input asp-for="Position" class="form-control" />
    <span asp-validation-for="Position" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Race" class="form-label"></label>
    <input asp-for="Race" class="form-control" />
    <span asp-validation-for="Race" class="text-danger"></span>
</div>
