@model ResultFormViewModel
@{
    ViewData["Title"] = "Edit result";
}

<h1 class="mb-3">Edit result</h1>
<p class="text-muted">Enrolment #@Model.EnrolmentId</p>

<form asp-action="Edit" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <partial name="_ResultFormFields" />

    <button type="submit" class="btn btn-primary">Save changes</button>
    <a asp-action="Index" asp-route-eventId="@Model.EventId" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
