@model DashboardViewModel
@{
    ViewData["Title"] = "Organiser dashboard";
}
 
<h1 class="mb-4">Organiser dashboard</h1>

<div class="row mb-4">
    <div class="col-md-6 mb-3">
        <div class="card text-center">
            <div class="card-body">
                <h2 class="display-5">@Model.TotalEvents</h2>
                <p class="text-muted mb-0">Events created</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="card text-center">
            <div class="card-body">
                <h2 class="display-5">@Model.TotalEnrolments</h2>
                <p class="text-muted mb-0">Total enrolments</p>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h2 class="h4 mb-0">Your events</h2>
    <a asp-controller="Events" asp-action="Create" class="btn btn-primary">Create event</a>
</div>

@if (!Model.Events.Any())
{
    <p>You have not created any events yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th class="text-end">Enrolments</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model.Events)
                {
                    <tr>
                        <td>@e.EventName</td>
                        <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (e.EventDate.Date >= DateTime.Today)
                            {
                                <span class="badge bg-success">Upcoming</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Past</span>
                            }
                        </td>
                        <td class="text-end">@e.TotalEnrolments</td>
                        <td class="text-end">
                            <a asp-controller="Enrolments" asp-action="Index" asp-route-eventId="@e.EventId" class="btn btn-sm btn-outline-primary">Enrolments</a>
                            <a asp-controller="Results" asp-action="Index" asp-route-eventId="@e.EventId" class="btn btn-sm btn-outline-secondary">Results</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
