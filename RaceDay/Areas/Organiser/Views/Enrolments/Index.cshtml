

@model List<EnrolmentViewModel>
@{
    ViewData["Title"] = "Enrolments";
    var confirmed = Model.Count(e => string.Equals(e.Status, "Confirmed", StringComparison.OrdinalIgnoreCase));
    var pending = Model.Count(e => string.Equals(e.Status, "Pending", StringComparison.OrdinalIgnoreCase));
}
<partial name="_EventTabs" />
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">Enrolments</h1>
        <p class="text-muted mb-0">@ViewBag.EventName</p>
    </div>
    <a asp-controller="Events" asp-action="Index" class="btn btn-secondary">Back to events</a>
</div>

<p>
    <strong>@Model.Count</strong> total
    <span class="mx-2">|</span> <strong>@confirmed</strong> confirmed
    <span class="mx-2">|</span> <strong>@pending</strong> pending
</p>

@if (!Model.Any())
{
    <p>Nobody has enrolled for this event yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Enrolment</th>
                    <th>Participant</th>
                    <th>Category</th>
                    <th>Date enrolled</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td>#@e.EnrolmentId</td>
                        @* Shows ids for now. Swap for names once your API returns them (see EnrolmentViewModel). *@
                        <td>@e.ParticipantId</td>
                        <td>@e.CategoryId</td>
                        <td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td>
                        <td><partial name="_StatusBadge" model="e.Status" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}