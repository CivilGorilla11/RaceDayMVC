@model EventFormViewModel

@* Shared by Create and Edit, so the fields are written once. *@
<input type="hidden" asp-for="EventId" />

<div class="mb-3">
    <label asp-for="EventName" class="form-label"></label>
    <input asp-for="EventName" class="form-control" />
    <span asp-validation-for="EventName" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="EventDate" class="form-label"></label>
    <input asp-for="EventDate" class="form-control" />
    <span asp-validation-for="EventDate" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Address" class="form-label"></label>
    <input asp-for="Address" class="form-control" />
    <span asp-validation-for="Address" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>

