@model List<RaceDay.Models.Events.EventViewModel>
@{
    ViewData["Title"] = "My events";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">My events</h1>
    <a asp-action="Create" class="btn btn-primary">Create event</a>
</div>

@if (!Model.Any())
{
    <p>You have not created any events yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th style="width:90px;"></th>
                    <th>Name</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(e.BannerUrl))
                            {
                                <img src="@e.BannerUrl" alt="" class="rounded" style="width:80px;height:48px;object-fit:cover;" />
                            }
                        </td>
                        <td>@e.EventName</td>
                        <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                        <td>@e.Address</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@e.EventId" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-controller="Categories" asp-action="Index" asp-route-eventId="@e.EventId" class="btn btn-sm btn-outline-secondary">Categories</a>
                            <a asp-controller="Enrolments" asp-action="Index" asp-route-eventId="@e.EventId" class="btn btn-sm btn-outline-secondary">Enrolments</a>
                            <a asp-controller="Results" asp-action="Index" asp-route-eventId="@e.EventId" class="btn btn-sm btn-outline-secondary">Results</a>

                            @* Delete is a POST form, never a link. The form tag helper adds the anti-forgery token for you. *@
                            <form asp-action="Delete" asp-route-id="@e.EventId" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this event? This cannot be undone.');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
